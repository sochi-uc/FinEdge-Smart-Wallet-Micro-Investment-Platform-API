{
  "ConnectionStrings": {
    "Accrue": "Data Source=App_Data/accrue.db"
  },
  "Jwt": {
    "Issuer": "accrue",
    "Audience": "accrue-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "AdminEmails": []
  },
  "Accrual": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "MoneyPermitPerMinute": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}